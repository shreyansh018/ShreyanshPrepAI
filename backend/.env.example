# Server
PORT=10000
NODE_ENV=production
NODE_VERSION=22

# Optional: serve frontend/dist from this process instead of Vercel.
# SERVE_FRONTEND=false

# Frontend origin(s), comma-separated. No trailing slash.
FRONTEND_URL=https://your-app.vercel.app

# MongoDB Atlas M0 - use ONE database for all collections.
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/shreyanshprepai

# Upstash Redis free plan. Use the rediss:// URL.
REDIS_URL=rediss://default:TOKEN@REGION.upstash.io:6379

# Firebase Admin service account.
# Option A: paste the full JSON on one line.
# Option B: base64-encode the JSON file and paste that.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Optional local path fallback:
# FIREBASE_SERVICE_ACCOUNT_PATH=./services/auth/serviceAccountKey.json

# Groq API key (backend only)
GROQ_API_KEY=

# YouTube Data API v3 key (backend only)
YOUTUBE_API_KEY=

# Razorpay test keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
